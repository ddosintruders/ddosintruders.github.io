---
import '@/styles/theme.css';
import { site } from '@/config/site';
import SectionRail from '@/components/chrome/SectionRail.astro';
import Preloader from '@/components/chrome/Preloader.astro';
import Cursor from '@/components/chrome/Cursor.astro';
import ThemeToggle from '@/components/chrome/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og.png', Astro.site ?? site.url).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: [site.role.primary.title, site.role.secondary.title],
  worksFor: [
    { '@type': 'Organization', name: site.role.primary.company },
    { '@type': 'Organization', name: site.role.secondary.company },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nakuru',
    addressCountry: 'KE',
  },
  sameAs: site.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Theme resolution, inline and render-blocking on purpose.

      This has to run before the first paint or a dark-mode visitor gets a
      white flash on every navigation. It is the one script on the page that
      cannot be deferred or bundled — hence `is:inline`. Astro includes it in
      the CSP hash set, so it stays covered by script-src.

      Stored choice wins; otherwise fall back to the OS setting.
    */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme =
            stored ??
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          // Private mode can throw on localStorage; the CSS media query still
          // gives a correct result, so just leave the attribute unset.
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08090b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000] focus:rounded-full focus:bg-accent-solid focus:px-5 focus:py-2.5 focus:font-mono focus:text-sm focus:font-medium focus:text-on-accent"
    >
      Skip to content
    </a>

    <Preloader />
    <Cursor />
    <ThemeToggle />
    <SectionRail />

    <main id="main">
      <slot />
    </main>

    <!-- Kept outside <main> so the footer is a sibling landmark, not content. -->
    <slot name="footer" />

    <div class="grain" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>

    <script>
      import { initScroll, bindAnchors } from '@/lib/scroll';
      import { initReveals } from '@/lib/reveals';
      import { initInteractions } from '@/lib/interactions';

      initScroll();
      bindAnchors();
      initReveals();
      initInteractions();

      // Enables the colour transition only after the first paint, so switching
      // themes animates but loading one never does.
      requestAnimationFrame(() => {
        document.documentElement.setAttribute('data-theme-ready', '');
      });
    </script>
  </body>
</html>
