---
/**
 * Theme toggle.
 *
 * The page follows the OS setting on first visit; this only exists so a visitor
 * can override it. An explicit choice is stored, and once stored the OS is no
 * longer consulted — otherwise flipping your laptop to dark at sunset would
 * silently undo a deliberate choice made ten minutes earlier.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="fixed top-5 right-5 z-[9994] flex h-10 w-10 items-center justify-center rounded-full border border-hairline bg-surface/80 text-muted backdrop-blur-sm transition-colors duration-300 hover:border-hairline-strong hover:text-text md:top-6 md:right-6"
  aria-label="Switch theme"
  data-cursor-label="Theme"
>
  <!-- Sun: shown in dark theme, i.e. "switch to light" -->
  <svg
    width="16"
    height="16"
    viewBox="0 0 16 16"
    fill="none"
    aria-hidden="true"
    class="absolute scale-50 opacity-0 transition-all duration-300 dark:scale-100 dark:opacity-100"
  >
    <circle cx="8" cy="8" r="3.25" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M8 1v1.5M8 13.5V15M15 8h-1.5M2.5 8H1M12.95 3.05l-1.06 1.06M4.11 11.89l-1.06 1.06M12.95 12.95l-1.06-1.06M4.11 4.11 3.05 3.05"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>

  <!-- Moon: shown in light theme, i.e. "switch to dark" -->
  <svg
    width="16"
    height="16"
    viewBox="0 0 16 16"
    fill="none"
    aria-hidden="true"
    class="absolute scale-100 opacity-100 transition-all duration-300 dark:scale-50 dark:opacity-0"
  >
    <path
      d="M13.5 9.4A5.9 5.9 0 0 1 6.6 2.5a5.9 5.9 0 1 0 6.9 6.9Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'theme';
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const describe = (theme: string) =>
    theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';

  const apply = (theme: string) => {
    root.setAttribute('data-theme', theme);
    button?.setAttribute('aria-label', describe(theme));
    // Lets the hero shader repaint its dots in the new palette.
    document.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
  };

  apply(root.getAttribute('data-theme') ?? 'light');

  button?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    localStorage.setItem(STORAGE_KEY, next);
    apply(next);
  });

  // Track the OS only while the visitor has not made a choice of their own.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (localStorage.getItem(STORAGE_KEY)) return;
    apply(event.matches ? 'dark' : 'light');
  });
</script>
