---
interface Props {
  index: string;
  label: string;
  title: string;
  lede?: string;
  class?: string;
}

const { index, label, title, lede, class: className = '' } = Astro.props;
---

<header class={`max-w-3xl ${className}`}>
  <!-- The mono index gets the decode effect: short, fixed-width, and it reads as
       a readout rather than as decoration on the headline itself. -->
  <span class="eyebrow" data-scramble>{index} — {label}</span>

  <h2 class="mt-5 font-display text-d2 text-text" data-reveal>{title}</h2>

  {
    lede && (
      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted" data-reveal>
        {lede}
      </p>
    )
  }
</header>
