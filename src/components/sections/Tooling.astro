---
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
---

<section id="tooling" class="shell scroll-mt-24 py-24 md:py-32">
  <SectionHeader
    index="03"
    label="Tooling"
    title="Five internal tools, built because the pipeline needed them."
    lede="Audit, QA, fraud detection and reporting systems built inside micro1's robotics training data pipeline. Not side projects — infrastructure the work depended on."
  />

  <div class="mt-16 grid gap-4 md:mt-20 lg:grid-cols-2">
    {
      tools.map((tool, index) => (
        <article
          data-spotlight
          data-reveal-fade
          class:list={[
            'spotlight-card group relative overflow-hidden rounded-xl border border-hairline bg-surface p-8 transition-colors duration-500 hover:border-hairline-strong md:p-10',
            // The first card spans both columns: FrameCapture is the most
            // substantial build and the grid should say so.
            index === 0 && 'lg:col-span-2',
          ]}
        >
          <div class="relative z-[2]">
            <div class="flex items-start justify-between gap-6">
              <div>
                <span class="font-mono text-[0.6875rem] tracking-[0.14em] text-faint">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-3 font-display text-2xl text-text">{tool.data.name}</h3>
                <p class="mt-1.5 font-mono text-[0.6875rem] tracking-[0.12em] text-accent uppercase">
                  {tool.data.kind}
                </p>
              </div>
            </div>

            <dl class="mt-8 space-y-5">
              <div class="grid gap-1.5 sm:grid-cols-[5.5rem_1fr] sm:gap-5">
                <dt class="eyebrow pt-0.5">Problem</dt>
                <dd class="text-sm leading-relaxed text-muted">{tool.data.problem}</dd>
              </div>
              <div class="grid gap-1.5 sm:grid-cols-[5.5rem_1fr] sm:gap-5">
                <dt class="eyebrow pt-0.5">Build</dt>
                <dd class="text-sm leading-relaxed text-muted">{tool.data.build}</dd>
              </div>
              <div class="grid gap-1.5 border-t border-hairline pt-5 sm:grid-cols-[5.5rem_1fr] sm:gap-5">
                <dt class="eyebrow pt-0.5">Effect</dt>
                <dd class="text-sm leading-relaxed text-text">{tool.data.effect}</dd>
              </div>
            </dl>
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-10 max-w-2xl text-sm leading-relaxed text-faint" data-reveal-fade>
    Also partnered directly with a Strategic Project Lead on an AI-Lab-facing
    engagement, contributing to the design, build and optimization of the labeling
    tools supporting the project.
  </p>
</section>
