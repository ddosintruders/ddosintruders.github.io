---
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';

const entries = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="experience" class="shell scroll-mt-24 py-24 md:py-32">
  <SectionHeader
    index="02"
    label="Experience"
    title="Two roles, both current, both in the human layer of AI."
    lede="micro1 supplies expert human data to frontier AI labs. human depth is building the platform for the people who do that work. I'm inside both."
  />

  <div class="mt-20 space-y-28 md:mt-28 md:space-y-36">
    {
      entries.map((entry) => (
        <article class="grid gap-10 lg:grid-cols-12 lg:gap-8">
          {/*
            Sticky rather than GSAP-pinned. Sticky needs no pin-spacer, survives
            resize and image-load reflow without a refresh, and cannot strand
            content mid-transform if a trigger mis-fires. GSAP is used for the
            entrance choreography only.
          */}
          <div class="lg:col-span-4">
            <div class="lg:sticky lg:top-28">
              <div class="flex items-center gap-3">
                <h3 class="font-display text-d3 text-text">{entry.data.company}</h3>
                {entry.data.current && (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent-dim px-2.5 py-1 font-mono text-[0.625rem] tracking-[0.12em] text-accent uppercase">
                    <span class="h-1 w-1 rounded-full bg-accent" />
                    Current
                  </span>
                )}
              </div>

              <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
                {entry.data.companyNote}
              </p>

              <p class="mt-6 font-mono text-[0.6875rem] tracking-[0.12em] text-faint uppercase">
                {entry.data.location}
              </p>

              {entry.data.headline && (
                <p class="mt-8 hidden max-w-xs font-display text-lg leading-snug text-accent lg:block">
                  {entry.data.headline}
                </p>
              )}
            </div>
          </div>

          <div class="lg:col-span-7 lg:col-start-6">
            {entry.data.roles.map((role, roleIndex) => (
              <div class="border-t border-hairline pt-8 first:border-t-0 first:pt-0 [&+*]:mt-12">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                  <h4 class="font-display text-xl text-text" data-reveal-fade>
                    {role.title}
                  </h4>
                  <span class="font-mono text-[0.6875rem] tracking-[0.12em] text-faint uppercase">
                    {role.period}
                  </span>
                </div>

                <ul class="mt-6 space-y-4">
                  {role.points.map((point) => (
                    <li
                      class="flex gap-4 text-sm leading-relaxed text-muted"
                      data-reveal-fade
                    >
                      <span
                        class="mt-2 h-px w-4 shrink-0 bg-hairline-strong"
                        aria-hidden="true"
                      />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>

                {/*
                  The promotion beat. Rendered between the two micro1 roles —
                  the single most compelling fact on the CV, so it gets to be a
                  moment rather than an inference the reader has to make.
                */}
                {roleIndex === 0 && entry.data.roles.length > 1 && (
                  <div
                    class="mt-12 flex items-center gap-4 rounded-lg border border-accent/25 bg-accent-dim px-5 py-4"
                    data-reveal-fade
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                      class="shrink-0 text-accent"
                    >
                      <path
                        d="M8 13V3M3.5 7.5 8 3l4.5 4.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <p class="font-mono text-[0.6875rem] leading-relaxed tracking-[0.1em] text-accent uppercase">
                      Promoted after one month
                    </p>
                  </div>
                )}
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>
