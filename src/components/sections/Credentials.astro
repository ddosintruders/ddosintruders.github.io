---
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';

const all = (await getCollection('credentials')).sort((a, b) => a.data.order - b.data.order);
const verified = all.filter((c) => c.data.status === 'verified');
const ongoing = all.filter((c) => c.data.status === 'ongoing');
---

<section id="credentials" class="shell scroll-mt-24 py-24 md:py-32">
  <SectionHeader
    index="05"
    label="Credentials"
    title="Verifiable, not decorative."
    lede="Every completed badge links straight to its Credly record. Click through and check."
  />

  <div class="mt-16 grid gap-12 md:mt-20 lg:grid-cols-2 lg:gap-16">
    <div>
      <h3 class="eyebrow">Completed</h3>
      <ul class="mt-6 divide-y divide-hairline border-t border-hairline">
        {
          verified.map((cred) => (
            <li>
              <a
                href={cred.data.url}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor-label="Verify"
                class="group flex items-center justify-between gap-6 py-5 transition-colors duration-300"
              >
                <span>
                  <span class="block text-base text-text transition-colors duration-300 group-hover:text-accent">
                    {cred.data.name}
                  </span>
                  <span class="mt-1 block font-mono text-[0.6875rem] tracking-[0.12em] text-faint uppercase">
                    {cred.data.issuer}
                  </span>
                </span>

                <span class="flex shrink-0 items-center gap-3">
                  <span class="font-mono text-[0.625rem] tracking-[0.12em] text-faint uppercase opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    Verify
                  </span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                    class="text-faint transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
                  >
                    <path
                      d="M4 10 10 4M10 4H5M10 4v5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="eyebrow">In progress</h3>
      <ul class="mt-6 divide-y divide-hairline border-t border-hairline">
        {
          ongoing.map((cred) => (
            <li class="flex items-center justify-between gap-6 py-5">
              <span>
                <span class="block text-base text-muted">{cred.data.name}</span>
                <span class="mt-1 block font-mono text-[0.6875rem] tracking-[0.12em] text-faint uppercase">
                  {cred.data.issuer}
                </span>
              </span>
              <span class="shrink-0 font-mono text-[0.625rem] tracking-[0.12em] text-faint uppercase">
                Ongoing
              </span>
            </li>
          ))
        }
      </ul>

      <p class="mt-8 font-mono text-[0.6875rem] leading-relaxed tracking-wide text-faint">
        Menengai High School — High School Diploma, Nakuru, 2020–2023
      </p>
    </div>
  </div>
</section>
