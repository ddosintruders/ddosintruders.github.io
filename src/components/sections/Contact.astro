---
import { site } from '@/config/site';
import SectionHeader from '@/components/ui/SectionHeader.astro';
---

<section id="contact" class="shell scroll-mt-24 py-24 md:py-32">
  <SectionHeader
    index="08"
    label="Contact"
    title="Let's talk."
    lede="Open to AI training and evaluation work, human data operations, and internal tooling builds. Book a slot directly, or send a note."
  />

  <div class="mt-16 grid gap-12 md:mt-20 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <form
        method="POST"
        action={site.formspree}
        class="space-y-6"
        data-contact-form
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="eyebrow block">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="mt-3 w-full border-0 border-b border-hairline-strong bg-transparent px-0 py-3 text-base text-text transition-colors duration-300 placeholder:text-faint focus:border-accent focus:ring-0 focus:outline-none"
              placeholder="Your name"
            />
          </div>

          <div>
            <label for="email" class="eyebrow block">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-3 w-full border-0 border-b border-hairline-strong bg-transparent px-0 py-3 text-base text-text transition-colors duration-300 placeholder:text-faint focus:border-accent focus:ring-0 focus:outline-none"
              placeholder="you@company.com"
            />
          </div>
        </div>

        <div>
          <label for="message" class="eyebrow block">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-3 w-full resize-y border-0 border-b border-hairline-strong bg-transparent px-0 py-3 text-base text-text transition-colors duration-300 placeholder:text-faint focus:border-accent focus:ring-0 focus:outline-none"
            placeholder="What are you working on?"></textarea>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button
            type="submit"
            data-magnetic="0.25"
            class="inline-flex items-center rounded-full bg-accent-solid px-7 py-3.5 font-mono text-xs font-medium tracking-[0.1em] text-on-accent uppercase transition-colors duration-300 hover:bg-text hover:text-bg"
          >
            <span data-magnetic-inner>Send message</span>
          </button>

          <p
            role="status"
            aria-live="polite"
            class="font-mono text-[0.6875rem] tracking-wide text-muted"
            data-form-status
          >
          </p>
        </div>
      </form>
    </div>

    <div class="lg:col-span-4 lg:col-start-9">
      <dl class="space-y-8">
        <div>
          <dt class="eyebrow">Book a call</dt>
          <dd class="mt-3">
            <a
              href={site.booking}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor-label="Book"
              class="group inline-flex items-center gap-2 text-base text-text transition-colors duration-300 hover:text-accent"
            >
              Pick a time
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              >
                <path
                  d="M4 10 10 4M10 4H5M10 4v5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </dd>
        </div>

        <div>
          <dt class="eyebrow">Email</dt>
          <dd class="mt-3">
            <a
              href={`mailto:${site.email}`}
              class="text-base text-text transition-colors duration-300 hover:text-accent"
            >
              {site.email}
            </a>
          </dd>
        </div>

        <div>
          <dt class="eyebrow">Based</dt>
          <dd class="mt-3 text-base text-muted">
            {site.location} · {site.locationNote}
          </dd>
        </div>

        <div>
          <dt class="eyebrow">Elsewhere</dt>
          <dd class="mt-3 flex flex-col gap-2">
            {
              site.socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-base text-muted transition-colors duration-300 hover:text-accent"
                >
                  {social.label}
                </a>
              ))
            }
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: the form posts natively to Formspree without JS.
  // With JS, submit over fetch so the visitor is never bounced to Formspree's
  // own thank-you page and back.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (status) status.textContent = 'Sending…';
    if (button) button.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.reset();
        if (status) status.textContent = 'Sent — I will get back to you.';
        return;
      }

      /*
       * Formspree refuses AJAX submissions on forms that have reCAPTCHA
       * enabled, answering 403 with "you need to set a custom key or reCAPTCHA
       * must be disabled". It has no way to show a challenge to a fetch call.
       *
       * Rather than dead-ending the visitor, hand off to a native POST. They
       * get bounced to Formspree's page to complete the CAPTCHA, which is
       * exactly how the previous version of this site behaved — the message
       * still arrives. Disabling reCAPTCHA in the Formspree dashboard restores
       * the stay-on-page path automatically; no code change needed.
       */
      let payload: { error?: string } | null = null;
      try {
        payload = await response.json();
      } catch {
        payload = null;
      }

      if (response.status === 403 && /recaptcha|custom key/i.test(payload?.error ?? '')) {
        if (status) status.textContent = 'Opening secure form…';
        // Prototype call, not form.submit(): a field named "submit" would
        // shadow the method. Bypasses this listener, so it cannot recurse.
        HTMLFormElement.prototype.submit.call(form);
        return;
      }

      if (status) {
        status.textContent = 'Something went wrong. Email me directly instead.';
      }
    } catch {
      if (status) status.textContent = 'Network error. Email me directly instead.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
