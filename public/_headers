# Cloudflare Pages headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # NOTE: Content-Security-Policy is NOT set here.
  #
  # Astro generates it as a <meta> tag with a per-build hash for every inline
  # script it emits (see `security.csp` in astro.config.mjs). Island hydration
  # scripts change hash on every build, so a static CSP in this file cannot
  # track them — and two CSPs are enforced as an intersection, meaning a stale
  # one here would silently block the hero backdrop and cursor again.
  #
  # X-Frame-Options above carries clickjacking protection, because
  # frame-ancestors is ignored in a meta-delivered CSP.

# Astro fingerprints everything under /_astro, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate or a deploy will not reach returning visitors.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
